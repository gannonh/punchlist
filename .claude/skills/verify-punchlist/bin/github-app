#!/usr/bin/env python3
"""Call the GitHub API as the Punchlist GitHub App (id 5254938), for live checks.

Run under with-env, which supplies GITHUB_APP_PRIVATE_KEY:
    with-env .claude/skills/verify-punchlist/bin/github-app GET "/app/hook/deliveries?per_page=10"
    with-env .claude/skills/verify-punchlist/bin/github-app POST /app/hook/deliveries/<id>/attempts
Prints the response body; never prints the key or the JWT.
"""
import base64, json, os, subprocess, sys, tempfile, time, urllib.request, urllib.error

def b64(d): return base64.urlsafe_b64encode(d).rstrip(b"=").decode()
import re, textwrap
raw = os.environ["GITHUB_APP_PRIVATE_KEY"]
# 1Password Environments store the key on one line; rebuild the PEM line breaks.
m = re.search(r"-----BEGIN ([A-Z ]+)-----(.*)-----END \1-----", raw, re.S)
pem = f"-----BEGIN {m[1]}-----\n" + "\n".join(textwrap.wrap(re.sub(r"\s", "", m[2]), 64)) + f"\n-----END {m[1]}-----\n"
now = int(time.time())
head = b64(json.dumps({"alg": "RS256", "typ": "JWT"}).encode())
body = b64(json.dumps({"iat": now - 60, "exp": now + 540, "iss": "5254938"}).encode())
with tempfile.TemporaryDirectory() as d:
    k = os.path.join(d, "k.pem")
    fd = os.open(k, os.O_WRONLY | os.O_CREAT, 0o600); os.write(fd, pem.encode()); os.close(fd)
    sig = subprocess.run(["openssl", "dgst", "-sha256", "-sign", k], input=f"{head}.{body}".encode(),
                         capture_output=True, check=True).stdout
jwt = f"{head}.{body}.{b64(sig)}"
method, path = sys.argv[1], sys.argv[2]
data = sys.argv[3].encode() if len(sys.argv) > 3 else None
req = urllib.request.Request("https://api.github.com" + path, method=method, data=data)
req.add_header("Accept", "application/vnd.github+json")
req.add_header("Authorization", "Bearer " + jwt)
if data: req.add_header("Content-Type", "application/json")
try:
    with urllib.request.urlopen(req) as r: out = r.read()
except urllib.error.HTTPError as e:
    out = e.read(); print("HTTP", e.code, file=sys.stderr)
print(out.decode() or "{}")
