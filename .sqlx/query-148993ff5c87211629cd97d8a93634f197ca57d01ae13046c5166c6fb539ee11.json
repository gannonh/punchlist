  "query": "SELECT public_id, user_agent, kind, created_at, last_used_at,\n                  COALESCE(id = $2, false) AS \"current!\"\n           FROM session\n           WHERE account_id = $1 AND expires_at > now()\n           ORDER BY last_used_at DESC, created_at DESC, public_id",
