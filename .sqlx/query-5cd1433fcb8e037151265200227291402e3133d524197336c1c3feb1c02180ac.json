{
  "db_name": "PostgreSQL",
  "query": "SELECT acc.id AS account_id, acc.name AS account_name, a.id, a.workspace_id, a.name\n         FROM account acc\n         JOIN actor a ON a.account_id = acc.id\n         JOIN workspace w ON w.id = a.workspace_id\n         WHERE acc.token_hash = $1\n         ORDER BY w.created_at, w.id\n         LIMIT 1",
