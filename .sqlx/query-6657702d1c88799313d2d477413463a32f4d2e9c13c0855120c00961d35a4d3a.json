{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT ON (c.issue_id) c.issue_id, c.body, e.seq\n           FROM comment c JOIN event e ON e.issue_id = c.issue_id AND e.comment_id = c.id\n           WHERE c.issue_id = ANY($1) AND c.body ILIKE $2 ESCAPE '\\'\n           ORDER BY c.issue_id, c.created_at DESC, e.seq DESC",
