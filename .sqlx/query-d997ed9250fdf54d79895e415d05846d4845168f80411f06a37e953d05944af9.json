  "query": "SELECT i.id AS issue_id, i.status AS issue_status, r.outcome FROM run r\n         JOIN issue i ON i.id = r.issue_id JOIN actor a ON a.run_id = r.id\n         WHERE r.id = $1 AND a.id = $2\n         FOR UPDATE OF i",
